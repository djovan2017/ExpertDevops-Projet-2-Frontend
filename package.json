{
  "name": "student-frontend",
  "version": "0.0.0",
  "scripts": {
  "ng": "ng",
  "start": "ng serve",
  "build": "ng build",
  "watch": "ng build --watch --configuration development",
  "test": "jest",
  "test:watch": "jest --watch",
  "e2e:clean": "rm -rf .nyc_output coverage && mkdir -p .nyc_output",
  "e2e": "cypress run --e2e --config screenshotOnRunFailure=false",
  "e2e:report": "nyc report",
  "e2e:check": "nyc check-coverage",
  "e2e:coverage": "npm run e2e:clean && npm run e2e && npm run e2e:report && npm run e2e:check"
},
  "private": true,
  "dependencies": {
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-browser-dynamic": "^20.0.7",
    "@angular/router": "^22.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.25",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@cypress/code-coverage": "^4.0.3",
    "@types/jest": "^29.5.4",
    "cypress": "^16.1.1",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.5.1",
    "typescript": "~5.7.2"
  }
}
